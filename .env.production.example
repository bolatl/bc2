# Public hostname, without https:// or a path; used by compose.yaml.
APP_DOMAIN=replace-me.example.com
# make prepare-deploy generates this in .env.deploy; never reuse the local secret.
SESSION_SECRET=
# Use a newly generated provider key, set here locally or in your host's secret UI.
# Empty means offline demo mode. Never put a real key in a VITE_* variable.
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=
# Demo card checkout uses the local mock provider; leave the Stripe key empty.
STRIPE_SECRET_KEY=
DISABLE_PAYWALL=false
FUNNEL=full
FREE_TURNS=5
ENABLE_REHEARSAL=true
# Public build-time display labels: match actual backend modes.
VITE_LLM_MODE=unknown
VITE_PAYMENT_MODE=mock
