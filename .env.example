# go run does not automatically read this file. Export variables in your shell.
ADDR=:8080
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
# Optional for local demos: omitted secret is generated securely at startup.
# SESSION_SECRET=replace-with-at-least-32-random-characters  (required when DATA_FILE is set)
COOKIE_SECURE=false
FREE_TURNS=4
MAX_TURNS=12
DIVERGENCE_THRESHOLD=4
ENABLE_REHEARSAL=false
# Empty uses deterministic, explicitly labelled demo checkout.
STRIPE_SECRET_KEY=
# true: paywall off for local testing (full session, invite and journal without payment).
DISABLE_PAYWALL=false
# Optional: persist couples, journal and private results to this JSON file (mode 0600).
# Requires a fixed SESSION_SECRET so cookies survive a restart. Raw answers are never written.
DATA_FILE=
# true: offer interim summaries (checkpoints) after the needs and partner_view stages.
ENABLE_CHECKPOINTS=false
# LLM API key (OpenAI or Anthropic). Empty uses the deterministic offline mock (no text leaves the server).
LLM_API_KEY=
# openai | anthropic (empty = auto-detect by key prefix sk-ant-)
LLM_PROVIDER=
# Empty = provider default (anthropic: claude-opus-5-5, openai: gpt-4o-mini)
LLM_MODEL=
LLM_BASE_URL=
