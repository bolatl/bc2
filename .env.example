# go run does not automatically read this file. Export variables in your shell.
ADDR=:8080
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
# Optional for local demos: omitted secret is generated securely at startup.
# SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
FREE_TURNS=4
MAX_TURNS=12
DIVERGENCE_THRESHOLD=4
ENABLE_REHEARSAL=false
# Empty uses deterministic, explicitly labelled demo checkout.
STRIPE_SECRET_KEY=
# Reserved for a future live LLM adapter. Current implementation always uses mock.
LLM_API_KEY=
